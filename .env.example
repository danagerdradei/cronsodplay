# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=America/Bogota
DJANGO_LOG_LEVEL=INFO
# En producción detrás de ALB/CloudFront con HTTPS:
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000

# --- PostgreSQL ---
POSTGRES_DB=cronso_dplay
POSTGRES_USER=cronso
POSTGRES_PASSWORD=cronso_dev_pass
# POSTGRES_HOST lo define docker-compose (db). En AWS: endpoint de RDS.
POSTGRES_PORT=5432

# --- Admin inicial (se crea al arrancar si no existe) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@cronso.com
DJANGO_SUPERUSER_PASSWORD=cambia-esto

# --- Reglas de negocio ---
SONG_MAX_PER_EMAIL=3
# 0 = el límite nunca se reinicia. 12 = se reinicia cada 12 horas (por noche).
SONG_LIMIT_WINDOW_HOURS=0
# --- Anti-abuso (la IP y el dispositivo solo los ve el Admin) ---
# Máximo por dispositivo (cookie anónima), aunque cambie de correo. 0 = sin límite.
SONG_MAX_PER_DEVICE=3
# Tope por IP pública: debe ser ALTO (el WiFi del bar y los operadores móviles comparten IP). 0 = sin límite.
SONG_MAX_PER_IP=15
SONG_IP_WINDOW_HOURS=12
# IPs o redes exentas del tope por IP, separadas por coma (ej. IP pública del WiFi de la discoteca).
SONG_IP_ALLOWLIST=
# Proxies delante de la app: 0 local, 2 con CloudFront + ALB, 1 con solo ALB o Nginx.
TRUSTED_PROXY_COUNT=0

# --- Inicio de sesión del público con Google ---
# Google Cloud > APIs y servicios > Credenciales > ID de cliente de OAuth > Aplicación web.
# Orígenes de JavaScript autorizados: http://localhost:8000 y http://localhost (y luego tu dominio https).
# Sin este valor la app funciona como antes (sin exigir Google).
GOOGLE_CLIENT_ID=
# 1 = exigir Google para pedir y puntuar (por defecto: 1 si hay GOOGLE_CLIENT_ID)
# GOOGLE_LOGIN_REQUIRED=1

# --- YouTube Data API v3 (gratis). Sin key la app funciona, pero sin vistas/likes/recomendación ---
# Crear en https://console.cloud.google.com/ > APIs y servicios > habilitar "YouTube Data API v3" > Credenciales > Clave de API
YOUTUBE_API_KEY=
# Buscar el video por "artista título" cuando no hay link de YouTube (100 unidades de cuota c/u)
YOUTUBE_SEARCH_FALLBACK=1
YOUTUBE_COMMENTS_MAX=100
YOUTUBE_CACHE_HOURS=24
ENRICH_ASYNC=1

DJ_PANEL_POLL_SECONDS=8
# URL pública que se codifica en los QR
PUBLIC_BASE_URL=http://localhost:8000
